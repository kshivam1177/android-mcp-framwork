{
  "name": "androidmcp-framework",
  "version": "0.1.31",
  "description": "A Model Context Protocol (MCP) server and CLI that gives coding agents tools for Android development: emulator + physical device builds, installs, UI automation, logs, coverage and testing intelligence.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "androidmcp-framework": "build/cli/index.js",
    "amf": "build/cli/index.js"
  },
  "main": "build/mcp/server.js",
  "exports": {
    ".": "./build/mcp/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build",
    "examples",
    "docs",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "gradle",
    "emulator",
    "uiautomator",
    "ai-agent",
    "claude",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node build/cli/index.js mcp",
    "typecheck": "tsc --noEmit",
    "start:mcp": "node build/cli/index.js mcp",
    "doctor": "node build/cli/index.js doctor",
    "inspect": "npx -y @modelcontextprotocol/inspector node build/cli/index.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "docs:check": "npm run build && node build/cli/index.js tools --json > /dev/null"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.4.5",
    "yargs": "^17.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.32",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kshivam1177/android-mcp-framwork.git"
  },
  "homepage": "https://github.com/kshivam1177/android-mcp-framwork#readme",
  "bugs": {
    "url": "https://github.com/kshivam1177/android-mcp-framwork/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
