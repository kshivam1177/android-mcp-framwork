{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kshivam1177/androidmcp-framework",
  "title": "AndroidMCP Framework",
  "description": "MCP server and CLI for Android development and change-aware Android and Flutter testing workflows.",
  "version": "0.1.2",
  "websiteUrl": "https://github.com/kshivam1177/android-mcp-framwork",
  "repository": {
    "url": "https://github.com/kshivam1177/android-mcp-framwork",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "androidmcp-framework",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "registryBaseUrl": "https://registry.npmjs.org",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
